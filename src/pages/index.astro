  <script is:inline>
    const header = document.querySelector("[data-header]");
    const menuButton = document.querySelector("[data-menu-trigger]");
    const menu = document.querySelector("#site-menu");
    menuButton?.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!open));
      menu.classList.toggle("is-open", !open);
    });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menu.classList.remove("is-open"); menuButton?.setAttribute("aria-expanded", "false"); }));
    window.addEventListener("scroll", () => header.classList.toggle("is-scrolled", window.scrollY > 14), { passive: true });
  </script>
