---
/** Kanopi Menteng English guide: source-forward, non-commercial visitor information. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Logo from "../../components/Logo.astro";

const title = "Suropati Park — Independent Menteng Visitor Guide";
const description = "An independent, non-profit guide to Suropati Park: a historic public green space in Menteng, Central Jakarta.";
const siteUrl = Astro.site ? new URL("/en/", Astro.site).href : undefined;
const faqEntries = [
  ["Is there an admission fee?", "This public city park is generally visited without an admission ticket. Travel, parking, food, and other personal costs may apply separately. Check current conditions if an event is taking place."],
  ["What is the best time to visit?", "Morning and late afternoon are often more comfortable for a slow walk. Jakarta weather, rain, heat, and activity in the park can change the experience."],
  ["How do I get here from the airport?", "From Soekarno–Hatta International Airport, use the airport rail service to a city interchange, then continue to Menteng by taxi, ride-hailing, or public transport. Confirm service details on your travel day."],
  ["Can I rely on a fixed bus route?", "No. Stop patterns and service can change. Use TransJakarta’s official route finder and a current journey planner to identify a practical Menteng-area stop before travelling."],
  ["Are toilets, accessible routes, and parking guaranteed?", "Do not assume so. Benches, paved paths, open space, and a fountain are documented public features, while toilets, parking, accessibility conditions, and other amenities should be confirmed in person or on a current map."],
  ["Where can I find food, shops, or accommodation?", "Menteng and central Jakarta offer many categories of eateries, groceries, pharmacies, and accommodation. This guide does not endorse businesses; compare access, opening hours, cost, and suitability yourself."],
  ["What is the park’s historical significance?", "It sits within the early twentieth-century garden-city planning of Menteng and was known as Bisschooplein. Its public-art context includes ASEAN sculptures discussed in published research."],
  ["Does the site present local legends as fact?", "No. We separate sourced urban history from informal or oral accounts. We do not present a local story as historical fact unless an open, checkable source supports it."]
];
const attractionJsonLd = { "@context": "https://schema.org", "@type": "TouristAttraction", name: "Suropati Park", alternateName: "Taman Suropati", description, url: siteUrl, image: siteUrl ? new URL("/images/taman-suropati-canopy.jpg", siteUrl).href : undefined, address: { "@type": "PostalAddress", streetAddress: "Jl. Taman Suropati No.5, RT.5/RW.5, Menteng", addressLocality: "Central Jakarta", addressRegion: "Jakarta", postalCode: "10310", addressCountry: "ID" }, geo: { "@type": "GeoCoordinates", latitude: -6.199387, longitude: 106.8326333 }, publicAccess: true };
const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqEntries.map(([question, answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
const cleanJson = (value: unknown) => JSON.parse(JSON.stringify(value));
---

<BaseLayout {title} {description} lang="en">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(cleanJson(attractionJsonLd))}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
  <a class="skip-link" href="#content">Skip to guide content</a>
  <header class="site-header" data-header>
    <Logo href="/en/" />
    <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-trigger><span>Menu</span><i></i><i></i></button>
    <nav id="site-menu" class="desktop-nav" aria-label="Primary navigation"><a href="#story">Story</a><a href="#visit">Visit</a><a href="#access">Getting here</a><a href="#services">Field guide</a><a href="#map">Map</a><a href="#faq">FAQ</a></nav>
    <div class="header-actions"><a class="language-switch" href="/" lang="id" hreflang="id">ID</a><a class="header-cta" href="#visit">Plan a visit <span>↘</span></a></div>
  </header>
  <main id="content">
    <section class="hero" id="home"><div class="hero-gridline hero-gridline--v" aria-hidden="true"></div><div class="hero-gridline hero-gridline--h" aria-hidden="true"></div><div class="hero-copy"><p class="eyebrow eyebrow--clay">URBAN GREEN SPACE · MENTENG</p><h1>Under<br />Menteng’s <em>canopy.</em></h1><p class="hero-lede">Suropati Park is a green pause where three historic streets meet—an invitation to walk, observe, and read Jakarta at a slower pace.</p><div class="hero-actions"><a class="button button--solid" href="#story">Start with the story <span>→</span></a><a class="button button--ghost" href="#map">See the location <span>↗</span></a></div><dl class="hero-facts"><div><dt>Address</dt><dd>Menteng, Central Jakarta</dd></div><div><dt>Type</dt><dd>Public city park</dd></div><div><dt>Character</dt><dd>Green · historic · civic</dd></div></dl></div><figure class="hero-image framed-photo"><img src="/images/taman-suropati-canopy.jpg" alt="A paved path and mature trees in Suropati Park" width="1920" height="1080" fetchpriority="high" /><figcaption><span>01 / CANOPY</span><span>Photo: Marwan Mohamad · CC BY-SA 4.0</span></figcaption></figure><div class="hero-coordinates"><span>06°11'58" S</span><span>106°49'57" E</span><b>+</b></div></section>

    <section class="intro-band" aria-labelledby="overview-title"><div class="section-marker"><span>01</span><i></i><small>OVERVIEW</small></div><div class="intro-copy"><p class="eyebrow">BEFORE YOU GO</p><h2 id="overview-title">Not a park to conquer in one photograph.</h2><p>Think of the park as a short civic pause: a place for light walking, tree shade, and close observation of Menteng. Arrive with a simple plan, then leave some room to wander.</p></div><div class="visit-card"><p class="eyebrow">AT A GLANCE</p><div><span>Admission</span><strong>Generally ticket-free</strong></div><div><span>Suggested time</span><strong>30–60 minutes</strong></div><div><span>Comfortable hours</span><strong>Morning or late afternoon</strong></div><p class="tiny-note">Opening conditions and on-site facilities can change. Verify if your schedule is tight or your needs are specific.</p></div></section>

    <section class="story-section" id="story" aria-labelledby="story-title"><div class="story-heading"><p class="eyebrow eyebrow--clay">02 / PLACE CONTEXT</p><h2 id="story-title">Green space designed<br />to let the city breathe.</h2></div><div class="story-rail"><span>MENTENG</span><i></i><span>BISSCHOOPLEIN</span><i></i><span>SUROPATI</span></div><div class="story-body"><p>Menteng grew from an early twentieth-century garden-city idea: housing, streets, and green space were considered together. In this planned district, Bisschooplein—the earlier name for the space now known as Suropati Park—began to take shape in the 1920s.</p><p>The meeting of Teuku Umar, Diponegoro, and Imam Bonjol Streets is not just a map feature. It reveals the park’s civic role: a breathing space within a network of streets and homes rather than leftover land at the edge of the city.</p><p>Today, notice the small things—tree shade, paved paths, benches, water, crossings, and older buildings around the perimeter. Together they are an urban archive still being used every day.</p></div><aside class="source-note"><span>SOURCE NOTE</span><p>The area history draws on an open Jakarta Cultural Department account of Menteng and Bisschooplein. This guide separates documented history from popular stories that lack an accessible source.</p><a href="https://dinaskebudayaan.jakarta.go.id/en/page/556/836?from=index" rel="noreferrer">Open the public source ↗</a></aside></section>

    <section class="photo-essay" aria-label="Suropati Park atmosphere"><figure class="photo-essay__wide"><img src="/images/taman-suropati-fountain.jpg" alt="A fountain among mature trees in Suropati Park" width="1920" height="1080" loading="lazy" /><figcaption>Water as a visual pause. Photo: Marwan Mohamad · CC BY-SA 4.0</figcaption></figure><div class="photo-essay__quote"><span class="quote-mark">“</span><p>Look at the small scale: benches, paving, leaf shadows, and the sound of water. That is where the park works best.</p><span class="quote-index">FIELD NOTE / 02</span></div></section>

    <section class="heritage-section" aria-labelledby="heritage-title"><div class="heritage-heading"><p class="eyebrow eyebrow--clay">03 / LAYERS OF MEANING</p><h2 id="heritage-title">More than shade:<br />city space and public art.</h2><p>This compact place brings together planning, everyday use, and public art. The entries below distinguish documented context from personal interpretation.</p></div><div class="heritage-grid"><article><span>01</span><h3>Garden city</h3><p>Menteng’s trees, streets, and public spaces were designed as a system. Suropati Park makes that planning idea legible at walking pace.</p></article><article><span>02</span><h3>Bisschooplein</h3><p>The earlier name appears in the district’s historical record. Its later identity as Suropati Park links an older colonial-era urban space with modern Indonesian civic memory.</p></article><article><span>03</span><h3>ASEAN public art</h3><p>Research on the park discusses sculptures by artists from ASEAN founding countries and relates them to peace, harmony, and unity. Read them as part of public space, not detached objects.</p></article><article class="heritage-note"><span>METHOD NOTE</span><p>We do not add untraceable legends. If you hear a local story during a visit, treat it as oral experience until a checkable source confirms it.</p><a href="https://www.matec-conferences.org/articles/matecconf/pdf/2019/29/matecconf_icsbe2019_03004.pdf" rel="noreferrer">Read the public-art study ↗</a></article></div></section>

    <section class="visit-section" id="visit" aria-labelledby="visit-title"><div class="section-marker section-marker--light"><span>04</span><i></i><small>VISIT</small></div><div class="visit-title"><p class="eyebrow">PRACTICAL PREPARATION</p><h2 id="visit-title">Arrive lightly.<br />Leave with context.</h2></div><div class="visit-grid"><article><span class="number">A</span><h3>Cost &amp; access</h3><p>The city park is commonly visited without an entry ticket. Budget separately for travel, parking, drinks, or needs outside the grounds.</p></article><article><span class="number">B</span><h3>Weather &amp; comfort</h3><p>Mornings and late afternoons are often more comfortable. Bring water, rain protection, and footwear suited to urban paths.</p></article><article><span class="number">C</span><h3>Parking &amp; drop-off</h3><p>Roadside capacity can be limited. Respect signs and choose a safe drop-off point without obstructing traffic or pedestrians.</p></article><article><span class="number">D</span><h3>Facilities to confirm</h3><p>Paths, benches, open space, and a fountain are documented. Confirm toilets, drinking water, worship facilities, baby needs, and accessibility when they matter to your visit.</p></article></div><p class="visit-disclaimer">This is an independent planning guide, not an operational notice. Conditions and event rules can change.</p></section>

    <section class="access-section" id="access" aria-labelledby="access-title"><div class="access-intro"><p class="eyebrow eyebrow--clay">05 / GETTING HERE</p><h2 id="access-title">Reach Menteng<br />with a flexible route.</h2><p>Do not rely on one fixed journey. Jakarta moves quickly; use live information, then choose transfers that fit the weather, your luggage, accessibility needs, and available time.</p></div><div class="access-routes"><article><div class="route-icon">✈</div><div><p class="eyebrow">FROM THE AIRPORT</p><h3>Soekarno–Hatta</h3><p>Use the airport rail service to a city interchange, then continue to Menteng by taxi, ride-hailing, or public transport. Check schedules and transfer points on your travel day.</p><a href="https://www.railink.co.id/" rel="noreferrer">Check the airport rail operator ↗</a></div></article><article><div class="route-icon">B</div><div><p class="eyebrow">BUS &amp; TRANSJAKARTA</p><h3>Routes can change</h3><p>Search active stops and connections for the Menteng area using the official route finder, then plan the final walking segment for real street and weather conditions.</p><a href="https://transjakarta.co.id/routes" rel="noreferrer">Check official routes ↗</a></div></article><article><div class="route-icon">↗</div><div><p class="eyebrow">TAXI &amp; RIDE-HAILING</p><h3>Choose a safe meeting point</h3><p>Enter “Taman Suropati” as the destination and agree on a pick-up point that does not block traffic. A short walk to a safer meeting point can be more practical at busy times.</p><a href="#map">See the coordinates ↘</a></div></article><article><div class="route-icon">R</div><div><p class="eyebrow">CITY RAIL &amp; TRANSFERS</p><h3>Use a hub, then continue</h3><p>If you arrive via urban or intercity rail, select a transfer hub that makes sense for Menteng. Compare street conditions, luggage, cost, and weather before walking or taking a vehicle onward.</p><a href="https://www.google.com/maps/search/?api=1&query=Taman+Suropati+Jakarta" rel="noreferrer">Check live journey options ↗</a></div></article><article><div class="route-icon">P</div><div><p class="eyebrow">PRIVATE CAR &amp; PARKING</p><h3>Plan the drop-off</h3><p>Do not assume dedicated park parking. Follow signs, avoid restricted roadside space, and use a current map to identify legal parking before approaching the park.</p><a href="#services">Read the service notes ↘</a></div></article><article><div class="route-icon">W</div><div><p class="eyebrow">WALKING &amp; CYCLING</p><h3>Read the pavement and weather</h3><p>Some of Menteng can be explored on foot, but crossings, pavement, heat, and rain matter. Use a pedestrian route planner rather than relying on old conditions.</p><a href="#around">Plan a district walk ↘</a></div></article></div></section>

    <section class="services-section" id="services" aria-labelledby="services-title"><div class="services-intro"><p class="eyebrow eyebrow--clay">06 / FIELD GUIDE</p><h2 id="services-title">Practical needs<br />worth considering first.</h2><p>This is not a business directory. Use it as a decision list: identify the service type you need, then confirm distance, hours, cost, access, and capacity through a current map or the relevant operator.</p></div><div class="services-grid"><article><span>WC</span><h3>Toilets &amp; hygiene</h3><p>Do not assume toilets, hand-washing, or baby facilities are always inside the park. Locate a suitable public or commercial facility nearby if this is essential.</p></article><article><span>P</span><h3>Parking &amp; drop-off</h3><p>Use legal parking or a drop-off point that does not obstruct movement. Signs, roadside rules, and capacity can change.</p></article><article><span>F&amp;B</span><h3>Food &amp; drink</h3><p>Menteng has many categories of food and drink venues. Choose by walking distance, dietary needs, budget, and opening hours—not a promotional list.</p></article><article><span>STAY</span><h3>Accommodation</h3><p>Central Jakarta has different accommodation types. Check late-hour access, transport connections, check-in rules, and the pedestrian route before booking.</p></article><article><span>SHOP</span><h3>Groceries &amp; pharmacy</h3><p>For water, rain gear, medicine, or daily necessities, use a current map to locate grocery, convenience, and pharmacy categories. Stock and opening hours vary.</p></article><article><span>EV</span><h3>Fuel &amp; charging</h3><p>Fuel stations and electric-vehicle charging are route needs, not park amenities. Use a map or network operator to locate a compatible facility before travelling.</p></article></div></section>

    <section class="around-section" id="around" aria-labelledby="around-title"><div class="around-head"><p class="eyebrow">07 / BEYOND THE PARK</p><h2 id="around-title">Continue with curiosity,<br />not a shopping list.</h2></div><div class="around-grid"><article class="around-photo"><img src="/images/taman-suropati-bench.jpg" alt="Park benches and a shaded path in Suropati Park" width="1920" height="1080" loading="lazy" /><p>Not every visit needs to be productive. Photo: Marwan Mohamad · CC BY-SA 4.0</p></article><div class="around-list"><article><span>01</span><div><h3>Walking &amp; green space</h3><p>Menteng’s streets, trees, and civic landmarks reward a slow route. Plan your return before evening and respect crossings.</p></div></article><article><span>02</span><div><h3>Daily services</h3><p>Food, drink, accommodation, groceries, pharmacies, fuel, and charging should be selected as categories that match your needs. This guide does not endorse a particular operator.</p></div></article><article><span>03</span><div><h3>Responsible pace</h3><p>Carry your own water, avoid leaving litter, keep volume low, and share benches and paths. A public park works through small mutual care.</p></div></article></div></div><div class="nearby-attractions"><p class="eyebrow">NEARBY PLACES TO EXPLORE</p><a href="https://www.google.com/maps/search/?api=1&query=Museum+Perumusan+Naskah+Proklamasi+Jakarta" rel="noreferrer">Museum of the Formulation of the Proclamation <span>↗</span></a><a href="https://www.google.com/maps/search/?api=1&query=Situ+Lembang+Park+Jakarta" rel="noreferrer">Situ Lembang Park <span>↗</span></a><a href="https://www.google.com/maps/search/?api=1&query=Taman+Menteng+Jakarta" rel="noreferrer">Menteng Park <span>↗</span></a></div></section>

    <section class="map-section" id="map" aria-labelledby="map-title"><div class="map-copy"><p class="eyebrow eyebrow--clay">08 / ON THE MAP</p><h2 id="map-title">Find the meeting point<br />of three streets.</h2><address>Jl. Taman Suropati No.5<br />RT.5/RW.5, Menteng<br />Central Jakarta, Jakarta 10310</address><p class="coordinates">-6.199387, 106.8326333</p><a class="button button--solid" href="https://maps.app.goo.gl/2uNrjJauUvnerqgW7" rel="noreferrer">Open in Google Maps <span>↗</span></a></div><div class="map-frame"><iframe title="Map of Suropati Park" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6853.551335042102!2d106.83005837690764!3d-6.199381660735676!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f416e4052ef9%3A0x8b3359cdbfba5a81!2sSuropati%20Park!5e1!3m2!1sid!2sid!4v1787020682192!5m2!1sid!2sid" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title"><div class="faq-heading"><p class="eyebrow">09 / FREQUENT QUESTIONS</p><h2 id="faq-title">Practical, without pretending<br />everything stays fixed.</h2><p>These answers help with early planning. For time-sensitive information, follow live operator information and on-site guidance.</p></div><div class="faq-list">{faqEntries.map(([question, answer], index) => <details><summary><span>{String(index + 1).padStart(2, "0")}</span><strong>{question}</strong><i>+</i></summary><p>{answer}</p></details>)}</div></section>

    <section class="legal-section" aria-labelledby="legal-title">
      <div><p class="eyebrow eyebrow--clay">USAGE NOTES</p><h2 id="legal-title">Transparent about sources,<br />clear about data choices.</h2></div>
      <div class="legal-details">
        <article class="heritage-note" style="padding:27px 24px 28px 24px;">
          <span style="display:inline-block;margin-bottom:14px;padding:5px 10px;border:1px solid var(--canopy);color:var(--canopy);font-family:var(--font-mono);font-size:9px;letter-spacing:.09em;">VERIFIED</span>
          <p style="margin:0;color:#17251f;font-size:13px;line-height:1.85;">Historical background, public activity records, and transportation directions for the area may reference the Pandeglang Regency Government website, spatial planning studies, and public tourism guides.</p>
        </article>
        <article class="heritage-note" style="padding:27px 24px 28px 24px;">
          <span style="display:inline-block;margin-bottom:14px;padding:5px 10px;border:1px solid var(--clay);color:var(--clay);font-family:var(--font-mono);font-size:9px;letter-spacing:.09em;">CONFIRM REQUIRED</span>
          <p style="margin:0;color:#17251f;font-size:13px;line-height:1.85;">Ticket prices, schedules, operating routes, restroom availability, parking spaces, energy services, and event conditions are all subject to change. Please confirm before using any service or altering your travel plans.</p>
        </article>
        <article class="heritage-note" style="padding:27px 24px 28px 24px;">
          <span style="display:inline-block;margin-bottom:14px;padding:5px 10px;border:1px solid var(--muted);color:var(--muted);font-family:var(--font-mono);font-size:9px;letter-spacing:.09em;">NOT ENDORSED</span>
          <p style="margin:0;color:#17251f;font-size:13px;line-height:1.85;">This website does not recommend or rank any specific businesses, operators, restaurants, hotels, shops, or services, nor does it receive any commercial benefit from the inclusion of such information.</p>
        </article>
      </div>
    </section>
  </main>
  <footer class="site-footer"><div class="footer-brand"><Logo compact href="/en/" /><p>An independent, non-profit guide to reading a park as public space, not a sales brochure.</p></div><div class="footer-source"><p class="eyebrow">PUBLIC REFERENCES</p><p>Area information is summarised from public materials by Jakarta institutions, transport operators, maps, and publicly available research. No commercial businesses are recommended.</p><p>Photo credit: Marwan Mohamad via Wikimedia Commons, <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noreferrer">CC BY-SA 4.0</a>.</p></div><div class="footer-meta"><p>© 2026 Suropati Park Guide.</p><p>This is an independent, non-profit visitor-information project and is not affiliated with the park operator, a public authority, or a commercial organisation.</p><div class="footer-legal-links"><a href="/en/privacy">Privacy</a><a href="/en/terms">Terms</a><a href="/en/cookies">Cookies</a></div></div></footer>
  <script is:inline>
    const header = document.querySelector("[data-header]"); const menuButton = document.querySelector("[data-menu-trigger]"); const menu = document.querySelector("#site-menu");
    menuButton?.addEventListener("click", () => { const open = menuButton.getAttribute("aria-expanded") === "true"; menuButton.setAttribute("aria-expanded", String(!open)); menu.classList.toggle("is-open", !open); });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menu.classList.remove("is-open"); menuButton?.setAttribute("aria-expanded", "false"); }));
    window.addEventListener("scroll", () => header.classList.toggle("is-scrolled", window.scrollY > 14), { passive: true });
  </script>
</BaseLayout>
